# -----------------------------------------------------------------------------
# homelab-backstage - environment variable reference
#
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# NEVER commit .env to git - it is listed in .gitignore.
# -----------------------------------------------------------------------------

# -- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=backstage

# -- Backstage secrets ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SECRET=change-me-backend-secret-32-chars-min
SESSION_SECRET=change-me-session-secret

# -- Keycloak OIDC (Backstage sign-in) ----------------------------------------
# The OIDC metadata URL is auto-discovered from the realm's well-known endpoint.
AUTH_OIDC_METADATA_URL=http://localhost:8080/realms/backstage/.well-known/openid-configuration
# Client ID of the "backstage" client in the Keycloak realm
AUTH_OIDC_CLIENT_ID=backstage
# Client secret - find it in Keycloak: Clients -> backstage -> Credentials
AUTH_OIDC_CLIENT_SECRET=change-me-in-production

# -- Keycloak catalog sync -----------------------------------------------------
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_LOGIN_REALM=master
KEYCLOAK_REALM=backstage
KEYCLOAK_CATALOG_CLIENT_ID=backstage-catalog-sync
KEYCLOAK_CATALOG_CLIENT_SECRET=change-me-catalog-sync

# -- Generic webhook backend ---------------------------------------------------
# Backstage forwards /api/webhooks/<app>/<event> to:
#   ${WEBHOOK_BASE_URL}/api/webhooks/${WEBHOOK_TENANT}/<app>/<event>
WEBHOOK_BASE_URL=http://localhost:3001
# Tenant path segment. Leave empty for the config default
# (backstage-production; backstage-development in the local-docker overlay).
WEBHOOK_TENANT=
# Optional HMAC signing secret shared with the webhook backend. When set, each
# upstream request carries x-backstage-timestamp + x-backstage-signature.
WEBHOOK_SIGNING_SECRET=

# -- Approvals (optional) ------------------------------------------------------
# Leave APPROVALS_BASE_URL empty to disable approval:request / approval:verify.
APPROVALS_BASE_URL=
# Recorded as the approval `source`; the status page only shows this source.
APPROVALS_SOURCE=backstage
# This Backstage backend's URL as reachable by the approval system (callbacks
# go to <url>/api/approvals/callbacks/...). Empty = BACKEND_BASE_URL.
APPROVALS_CALLBACK_BASE_URL=
# 32+ chars; signs callback URLs and continuations. Keep stable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APPROVALS_SIGNING_SECRET=
# Keycloak service account used to call the approval API.
APPROVALS_OIDC_METADATA_URL=
APPROVALS_CLIENT_ID=
APPROVALS_CLIENT_SECRET=

# -- GitHub (catalog location for homelab-backstage-assets) -------------------
GITHUB_TOKEN_ASSETS=

# -- Production overrides (not used in local compose) -------------------------
# APP_BASE_URL=https://backstage.example.com
# BACKEND_BASE_URL=https://backstage.example.com
